<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../nugets" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Pin Krilla to the local feed. Without this, NuGet sees the same version in both feeds —
       the locally-built nupkg in ../nugets and whatever is published on nuget.org — and picks
       nondeterministically, which on CI reliably means the published bits. That would make
       this suite test the last release rather than the build that just produced it, which is
       the opposite of its purpose. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Krilla" />
      <package pattern="Krilla.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- Deliberately no signatureValidationMode. src/nuget.config requires signed packages, but
       the whole point here is consuming an unsigned, freshly built local nupkg. -->
</configuration>
