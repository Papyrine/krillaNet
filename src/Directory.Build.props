<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="Krilla.Native.props" />
  <PropertyGroup>
    <NoWarn>CS1591;NU1608</NoWarn>
    <Version>0.2.0</Version>
    <LangVersion>preview</LangVersion>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <Description>Creates PDF files via the krilla Rust library</Description>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!--
      Plain MIT, unlike the other Papyrine packages: this repository does not participate in
      the Open Source Maintenance Fee, so there is no EULA and nothing to accept.
    -->
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <Papyrine_SponsorshipLicenseIgnored>true</Papyrine_SponsorshipLicenseIgnored>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\license.txt" Pack="true" PackagePath="" Visible="false" />
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="CharSpan" />
  </ItemGroup>
</Project>
