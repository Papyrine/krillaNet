<Solution>
  <Folder Name="/Solution Items/">
    <File Path="../.gitattributes" />
    <File Path="../readme.md" />
    <File Path="../.editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="Directory.Packages.props" />
    <File Path="Krilla.Native.props" />
    <File Path="Krilla.Native.targets" />
    <File Path="../global.json" />
    <File Path="mdsnippets.json" />
  </Folder>
  <Folder Name="/Rust/">
    <File Path="../rust/Cargo.toml" />
    <File Path="../rust/crates/krilla-capi/Cargo.toml" />
  </Folder>
  <Project Path="Krilla/Krilla.csproj" />
  <Project Path="Krilla.Tests/Krilla.Tests.csproj" />
  <Project Path="Krilla.Html/Krilla.Html.csproj" />
  <Project Path="Krilla.Html.Tests/Krilla.Html.Tests.csproj" />
  <Project Path="Krilla.Html.RefGen/Krilla.Html.RefGen.csproj" />
  <Project Path="Krilla.Html.Benchmarks/Krilla.Html.Benchmarks.csproj" />
  <!--
    The Blazor WebAssembly app and its tests, excluded from Release solution builds. The app sets
    WasmBuildNative (it has to: the krilla native is a static archive linked into the app's own
    .wasm module), which needs the wasm-tools workload. A plain Release build of the solution
    on a machine without it would fail on a project nothing else depends on. They are built by path in .github/workflows/deploy-blazor.yml instead. See
    Krilla.Web/README.md.
  -->
  <Project Path="Krilla.Web/Krilla.Web.csproj">
    <Build Solution="Release|*" Project="false" />
  </Project>
  <Project Path="Krilla.Web.Tests/Krilla.Web.Tests.csproj">
    <Build Solution="Release|*" Project="false" />
  </Project>
</Solution>
