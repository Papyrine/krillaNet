<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!--
      No UseCurrentRuntimeIdentifier here, unlike Morph.PDFium.Tests. That pair of properties
      exists there to stop the SDK unpacking twelve RIDs of pdfium out of the bblanchon
      packages. Krilla's native arrives across the ProjectReference as a single copy-local
      item, already flattened and already scoped to this machine, so setting a runtime
      identifier would buy nothing and would change how everything else resolves.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MarkdownSnippets.MsBuild" PrivateAssets="all" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Verify" />
    <!-- Renders produced PDFs to PNG via PDFium so snapshots assert what a reader actually
         draws, not just the bytes krilla emitted. -->
    <PackageReference Include="Verify.PDFium" />
    <PackageReference Include="Argon" />
    <PackageReference Include="DiffEngine" />
    <PackageReference Include="EmptyFiles" />
    <PackageReference Include="SimpleInfoName" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Krilla\Krilla.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The HTML corpus's pinned fonts, shared rather than copied. Font lookup and text
         measuring are tested against these so the results are the same on every machine. -->
    <None Include="..\Krilla.Html.Tests\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
