<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      BenchmarkDotNet builds and runs each benchmark in a child process of its own, and refuses to
      do so from a debug build. The project is still built in Debug by a plain solution build, which
      is what keeps it compiling; only running it needs Release.
    -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Krilla.Html\Krilla.Html.csproj" />
  </ItemGroup>
</Project>
