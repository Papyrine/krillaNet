<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!--
      Both properties exist for pdfium, not for krilla. Morph.PDFium pulls the bblanchon packages,
      which carry twelve RIDs of native, and without these the SDK unpacks every one of them.
      Krilla's own native needs neither — it arrives across the ProjectReference already flattened
      and already scoped to this machine — but setting them does not disturb it, because
      Krilla.Native.targets resolves the host from $(NETCoreSdkPortableRuntimeIdentifier) rather
      than from $(RuntimeIdentifier).
    -->
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MarkdownSnippets.MsBuild" PrivateAssets="all" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Verify" />
    <PackageReference Include="Verify.DiffPlex" />
    <PackageReference Include="Morph.PDFium" />
    <PackageReference Include="Verify.PDFium" />
    <PackageReference Include="Argon" />
    <PackageReference Include="DiffEngine" />
    <PackageReference Include="EmptyFiles" />
    <PackageReference Include="SimpleInfoName" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Krilla.Html\Krilla.Html.csproj" />
  </ItemGroup>
</Project>
