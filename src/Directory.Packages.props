<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.10.1" />
    <PackageVersion Include="AngleSharp.Css" Version="1.4.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="29.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Krilla.Web (the Blazor WASM app) and its test project. Both are excluded from Release
         solution builds in Krilla.slnx, because a WasmBuildNative app needs the wasm-tools
         workload; they are built by path in deploy-blazor.yml instead. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="bunit" Version="2.14.0" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.2.0" />
    <PackageVersion Include="ProjectFiles" Version="1.6.0" />
    <PackageVersion Include="Morph.PDFium" Version="1.6.1" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.188" />
    <PackageVersion Include="TUnit" Version="1.81.16" />
    <PackageVersion Include="Verify" Version="33.3.4" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="Verify.PDFium" Version="2.2.2" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="DiffEngine" Version="20.9.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
  </ItemGroup>
</Project>